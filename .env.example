# PostgreSQL (matches docker-compose.yml)
POSTGRES_PASSWORD=jaha_eye_dev_secret
DATABASE_URL=postgresql://postgres:jaha_eye_dev_secret@localhost:5432/jaha_eye

# Model provider — use Ollama locally or OpenAI in the cloud
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
# Cloud OpenAI example:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=

# API server (localhost bind + shared operator token)
API_PORT=4000
API_HOST=127.0.0.1
API_TOKEN=change-me-local-dev-token
WEB_ORIGIN=http://localhost:5173

# Agent network tools (http_request, web_fetch)
#   all                            → any public host (private/loopback IPs stay blocked)
#   technopolis.bg,www.technopolis.bg → only these exact hostnames
#   empty / unset                  → deny all
HTTP_ALLOWED_HOSTS=all

# Web search (SearXNG — started via docker-compose.tools.yml)
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_SECRET=change-me-local-searxng-secret

# Web dev server (Vite proxy targets API; injects API_TOKEN server-side)
VITE_API_URL=http://localhost:4000

# Runtime mode (optional) — development enables Prisma warning logs
# NODE_ENV=development

# Office operator layer (default on; set 0 to disable /api/office and run hooks)
# OFFICE_ENABLED=0
# OFFICE_ROUTER_MODEL=gpt-4o-mini
# OFFICE_TEAM_MAX=4
# BRAIN_EXPORT_DIR=
