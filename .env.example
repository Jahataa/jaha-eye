# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jaha_eye

# Model provider — use Ollama locally or OpenAI in the cloud
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
# Cloud OpenAI example:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=

# API server
API_PORT=4000
API_HOST=0.0.0.0

# Web dev server (Vite proxy targets API)
VITE_API_URL=http://localhost:4000
