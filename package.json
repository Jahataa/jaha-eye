{
  "name": "jaha-eye",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "local:start": "node scripts/local-dev.mjs start",
    "local:stop": "node scripts/local-dev.mjs stop",
    "local:status": "node scripts/local-dev.mjs status",
    "db:generate": "dotenv -e .env -- npm run generate -w @jaha-eye/database",
    "db:migrate": "dotenv -e .env -- npm run migrate -w @jaha-eye/database",
    "db:migrate:deploy": "dotenv -e .env -- npm run migrate:deploy -w @jaha-eye/database",
    "db:push": "dotenv -e .env -- npm run push -w @jaha-eye/database",
    "db:seed": "dotenv -e .env -- npm run seed -w @jaha-eye/database"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
