generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  active
  disabled
}

enum RunStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
}

enum RunTrigger {
  manual
  schedule
}

enum ScheduleTargetType {
  agent
  orchestration
}

enum OrchestrationStatus {
  active
  disabled
}

enum OfficeTaskStatus {
  routing
  queued
  running
  waiting
  done
  error
  cancelled
  scheduled
}

enum OfficeTaskRunMode {
  normal
  draft
  approve
  revise
  team
}

enum LessonKind {
  standing
  oneoff
}

enum BrainNoteKind {
  note
  deliverable
}

model Agent {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  description       String?
  department        String?     @map("department")
  brief             String?
  isDepartmentLead  Boolean     @default(false) @map("is_department_lead")
  status            AgentStatus @default(active)
  modelProvider     String      @default("openai") @map("model_provider")
  modelName         String      @default("gpt-4o-mini") @map("model_name")
  modelBaseUrl      String?     @map("model_base_url")
  modelTemperature         Float @default(0.7) @map("model_temperature")
  modelContextWindowLimit  Int?  @map("model_context_window_limit")
  modelMaxTokens           Int?  @map("model_max_tokens")
  systemPrompt             String @default("You are a helpful assistant.") @map("system_prompt")
  tools             Json        @default("[]")
  defaultRunInput   String?     @map("default_run_input")
  maxConcurrentRuns Int         @default(1) @map("max_concurrent_runs")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  runs        AgentRun[]
  schedules   Schedule[]
  officeTasks OfficeTask[]
  lessons     Lesson[]
  routines    Routine[]
  brainNotes  BrainNote[]

  @@index([department])
  @@map("agents")
}

model Orchestration {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  description     String?
  status          OrchestrationStatus @default(active)
  hidden          Boolean             @default(false)
  graph           Json
  defaultRunInput String?             @map("default_run_input")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  runs      AgentRun[]
  schedules Schedule[]

  @@map("orchestrations")
}

model AgentRun {
  id              String     @id @default(uuid())
  agentId         String?    @map("agent_id")
  orchestrationId String?    @map("orchestration_id")
  graphNodeId     String?    @map("graph_node_id")
  parentRunId     String?    @map("parent_run_id")
  status          RunStatus  @default(queued)
  trigger         RunTrigger @default(manual)
  input           Json
  output          Json?
  error           Json?
  startedAt       DateTime?  @map("started_at")
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orchestration Orchestration? @relation(fields: [orchestrationId], references: [id], onDelete: SetNull)
  parent        AgentRun?      @relation("RunHierarchy", fields: [parentRunId], references: [id])
  children      AgentRun[]     @relation("RunHierarchy")
  events          AgentRunEvent[]
  officeTaskRuns  OfficeTaskRun[]
  runUsage        RunUsage?
  brainNotes      BrainNote[]

  @@index([agentId])
  @@index([orchestrationId])
  @@index([parentRunId])
  @@index([status])
  @@map("agent_runs")
}

model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  sequence  Int
  type      String
  timestamp DateTime
  payload   Json

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
  @@map("agent_run_events")
}

model Schedule {
  id              String             @id @default(uuid())
  name            String?
  enabled         Boolean            @default(true)
  targetType      ScheduleTargetType @map("target_type")
  agentId         String?            @map("agent_id")
  orchestrationId String?            @map("orchestration_id")
  expression      String
  input           String?
  lastFiredAt     DateTime?          @map("last_fired_at")
  lastFiredSlot   String?            @map("last_fired_slot")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orchestration Orchestration? @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([orchestrationId])
  @@index([enabled])
  @@map("schedules")
}

model AppSettings {
  id                 String   @id @default("default")
  llmApiKey          String?  @map("llm_api_key")
  llmBaseUrl         String?  @map("llm_base_url")
  defaultModelName   String   @default("gpt-4o-mini") @map("default_model_name")
  defaultTemperature  Float    @default(0.7) @map("default_temperature")
  usageBudgetTokens   Int?     @map("usage_budget_tokens")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model OfficeTask {
  id              String           @id @default(uuid())
  department      String
  agentId         String?          @map("agent_id")
  title           String           @default("")
  text            String
  status          OfficeTaskStatus @default(routing)
  needsOk         Boolean          @default(false) @map("needs_ok")
  plan            Json             @default("[]")
  draft           String?
  result          String?
  scheduledAt     DateTime?        @map("scheduled_at")
  late            Boolean          @default(false)
  routineId       String?          @map("routine_id")
  teamParentRunId String?          @map("team_parent_run_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  agent     Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  routine   Routine?        @relation(fields: [routineId], references: [id], onDelete: SetNull)
  taskRuns  OfficeTaskRun[]

  @@index([status])
  @@index([department])
  @@index([agentId])
  @@index([scheduledAt])
  @@map("office_tasks")
}

model OfficeTaskRun {
  id        String            @id @default(uuid())
  taskId    String            @map("task_id")
  runId     String            @map("run_id")
  mode      OfficeTaskRunMode @default(normal)
  createdAt DateTime          @default(now()) @map("created_at")

  task OfficeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run  AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([taskId, runId])
  @@index([runId])
  @@map("office_task_runs")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  body        String
  agentIds    Json     @default("[]") @map("agent_ids")
  departments Json     @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model Lesson {
  id           String     @id @default(uuid())
  agentId      String     @map("agent_id")
  kind         LessonKind
  text         String
  sourceTaskId String?    @map("source_task_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("lessons")
}

model BrainNote {
  id        String        @id @default(uuid())
  slug      String        @unique
  title     String
  body      String
  kind      BrainNoteKind @default(note)
  agentId   String?       @map("agent_id")
  taskId    String?       @map("task_id")
  runId     String?       @map("run_id")
  links     Json          @default("[]")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  agent Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@map("brain_notes")
}

model Routine {
  id            String   @id @default(uuid())
  name          String
  department    String
  agentId       String   @map("agent_id")
  text          String
  expression    String
  needsOk       Boolean  @default(false) @map("needs_ok")
  team          Boolean  @default(false)
  enabled       Boolean  @default(true)
  lastFiredAt   DateTime? @map("last_fired_at")
  lastFiredSlot String?  @map("last_fired_slot")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tasks OfficeTask[]

  @@index([agentId])
  @@index([enabled])
  @@map("routines")
}

model RunUsage {
  id           String   @id @default(uuid())
  runId        String   @unique @map("run_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  model        String   @default("")
  estimated    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("run_usage")
}
