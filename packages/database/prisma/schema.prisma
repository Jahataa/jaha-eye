generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  active
  disabled
}

enum RunStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
}

enum RunTrigger {
  manual
}

model Agent {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  description       String?
  status            AgentStatus @default(active)
  modelProvider     String      @default("openai") @map("model_provider")
  modelName         String      @default("gpt-4o-mini") @map("model_name")
  modelBaseUrl      String?     @map("model_base_url")
  modelTemperature  Float       @default(0.7) @map("model_temperature")
  systemPrompt      String      @default("You are a helpful assistant.") @map("system_prompt")
  tools             Json        @default("[]")
  maxConcurrentRuns Int         @default(1) @map("max_concurrent_runs")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  runs AgentRun[]

  @@map("agents")
}

model AgentRun {
  id          String     @id @default(uuid())
  agentId     String     @map("agent_id")
  parentRunId String?    @map("parent_run_id")
  status      RunStatus  @default(queued)
  trigger     RunTrigger @default(manual)
  input       Json
  output      Json?
  error       Json?
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  agent    Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent   AgentRun?       @relation("RunHierarchy", fields: [parentRunId], references: [id])
  children AgentRun[]    @relation("RunHierarchy")
  events   AgentRunEvent[]

  @@index([agentId])
  @@index([status])
  @@map("agent_runs")
}

model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  sequence  Int
  type      String
  timestamp DateTime
  payload   Json

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
  @@map("agent_run_events")
}
